  "rules": [
    "正式版本由内容摘要、依赖与能力集合共同唯一确定，重复上传返回既有版本",
    "内容摘要对规范化后的文件摘要、依赖、入口点和能力集合取 SHA-256",
    "能力按风险路由到代码审查、数据所有者或财务审批，能力扩大必须重新审查",
    "签名只覆盖内容摘要、能力集合与审查环节，内容或依赖漂移时验签失败",
    "所有必需环节签署且验签通过才能成为正式版本，并发审批只产生一个正式版本",
    "租户启用需同时满足地区、套餐与冲突能力约束",
    "灰度分组由版本、租户与批次开始时固定的盐确定，批次期间规则不可变化",
    "异常率越线立即冻结新分配，回滚退到最近安全版本且分批可续跑",
    "隔离只作用于单个版本，并保留受影响任务清单",
    "回滚必须保留历史安装清单和影响任务，安装时记录逐文件确切摘要"
  ]
}
